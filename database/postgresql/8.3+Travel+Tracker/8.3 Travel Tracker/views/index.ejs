<%- include("header.ejs") %>

<div class="container">
  <div class="header">
    <h1>Travel Tracker</h1>
    <h2 id="total-countries">Total Countries: <%= total %></h2>
  </div>

  <style>
    /* Pintamos los países visitados con el color del usuario */
    <% countries.forEach(function(country) { %>
      #<%= country.code %> {
        fill: <%= country.color %> !important;
      }
    <% }); %>
  </style>

  <div class="map-container">
    <svg id="map" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000">
      <path id="AF" d="..." />
      <path id="PE" d="M325.2,525.1l-1.3,4.2l-3.3,1.3l-3.3-0.8l-1.4-2.8l-0.3-4.1l1.4-3.5l4-0.8L325.2,525.1z" />
    </svg>
  </div>

  <form class="item" action="/add" method="post">
    <input type="text" name="country" placeholder="Enter country name" autocomplete="off" autofocus="true" />
    <button type="submit" style="background-color: <%= color %>">ADD</button>
  </form>

  <div class="user-selector">
    <form action="/user" method="post">
      <% users.forEach(function(user) { %>
        <button type="submit" name="user" value="<%= user.id %>" class="user-button" style="background-color: <%= user.color %>">
          <%= user.name %>
        </button>
      <% }); %>
    </form>
  </div>
</div>

<%- include("footer.ejs") %>